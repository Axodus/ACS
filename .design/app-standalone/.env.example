# Standalone Vite UI template.
# VITE_* is browser-visible and must remain browser-safe.
#
# LOCAL
# Browser origin may use localhost only in LOCAL.
VITE_ACS_ENVIRONMENT=local
VITE_ACS_API_BASE_URL=http://127.0.0.1:8788/api/v1
VITE_ACS_TENANT_ID=tenant-dev
VITE_ACS_TENANT_ADMIN_URL=/admin/tenants

# DEVELOPMENT
# Public browser-reachable API origin only.
VITE_ACS_ENVIRONMENT=development
VITE_ACS_API_BASE_URL=https://acs-axodus.up.railway.app/api/v1
VITE_ACS_TENANT_ID=tenant-dev
VITE_ACS_TENANT_ADMIN_URL=/admin/tenants

# PRODUCTION
# Public browser-reachable production API origin only.
VITE_ACS_ENVIRONMENT=production
VITE_ACS_API_BASE_URL=https://acs-api.example.com/api/v1
VITE_ACS_TENANT_ID=tenant-dev
VITE_ACS_TENANT_ADMIN_URL=/admin/tenants
