# Standalone Vite UI. VITE_* is inlined at build/dev time.
# Vite loads .env, .env.local, .env.[mode], .env.[mode].local.
# Railway is the default API target; copy localhost values to .env.local.
# Browser clients cannot use *.railway.internal; that DNS is private to Railway.
VITE_ACS_API_BASE_URL=https://acs-axodus.up.railway.app/api/v1
VITE_ACS_ENVIRONMENT=local
VITE_ACS_TENANT_ID=tenant-dev
VITE_ACS_TENANT_ADMIN_URL=/admin/tenants
