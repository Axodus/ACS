    "buffer": "6.0.3",
    "process": "0.11.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.0.0",
    "viem": "^2.55.19",
    "wagmi": "2.19.5"
