# ACS runtime configuration template.
# Supported environments: local, development, production.
#
# LOCAL
ACS_ENVIRONMENT=local
ACS_HTTP_HOST=127.0.0.1
ACS_HTTP_PORT=8788
ACS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACS_AUTH_MODE=development
ACS_SECRET_PROVIDER=memory
ACS_DISPATCH_MODE=local
ACS_OPENCLAW_WORKER_MODE=local
ACS_OPENCLAW_TRANSPORT=stdio
ACS_HTTP_HSTS=false

# DEVELOPMENT
ACS_ENVIRONMENT=development
ACS_HTTP_HOST=0.0.0.0
# Railway must map its injected PORT to ACS_HTTP_PORT for hosted development.
ACS_HTTP_PORT=${PORT}
ACS_ALLOWED_ORIGINS=https://acs-app.axodus.country,http://localhost:3000,http://127.0.0.1:3000
ACS_AUTH_MODE=development
# DEVELOPMENT ONLY — ephemeral/non-production providers and stores.
ACS_SECRET_PROVIDER=memory
ACS_DISPATCH_MODE=remote
ACS_OPENCLAW_WORKER_MODE=cloud
ACS_OPENCLAW_TRANSPORT=https
# Private Railway service-to-service endpoint for OpenClaw Worker — Cloud.
ACS_OPENCLAW_CLOUD_BASE_URL=https://exquisite-enjoyment.railway.internal
ACS_HTTP_HSTS=false
ACS_ECONOMIC_STORE=sqlite
ACS_ECONOMIC_DATABASE_PATH=/tmp/acs-economic.sqlite
ACS_AGENT_STORE=sqlite
ACS_AGENT_DATABASE_PATH=/tmp/acs-agent.sqlite
ACS_RUNTIME_DATABASE_PATH=/tmp/acs-runtime.sqlite
ACS_DEPLOYMENT_STORE=sqlite
ACS_DEPLOYMENT_DATABASE_PATH=/tmp/acs-deployment.sqlite
ACS_RATE_LIMIT_PROVIDER=sqlite
ACS_RATE_LIMIT_DATABASE_PATH=/tmp/acs-rate-limit.sqlite
ACS_SECRET_CATALOG_PATH=/tmp/acs-secret-catalog.sqlite
ACS_RUNTIME_ROOT=/tmp/acs-runtime
ACS_STATE_ROOT=/tmp/acs-runtime/.acs/state
ACS_CONFIG_ROOT=/tmp/acs-runtime/.acs/config
ACS_ARTIFACTS_ROOT=/tmp/acs-runtime/.acs/artifacts
ACS_WORKSPACE_ROOT=/tmp/acs-runtime/.acs/workspace

# PRODUCTION
ACS_ENVIRONMENT=production
ACS_HTTP_HOST=0.0.0.0
ACS_HTTP_PORT=<service-port>
ACS_ALLOWED_ORIGINS=https://acs-app.example.com,https://acs-api.example.com
ACS_AUTH_MODE=production
# Use the concrete production secret provider configured for the service.
ACS_SECRET_PROVIDER=<production-secret-provider>
ACS_DISPATCH_MODE=remote
ACS_OPENCLAW_WORKER_MODE=remote
ACS_OPENCLAW_TRANSPORT=https
ACS_OPENCLAW_WORKER_BASE_URL=https://openclaw-worker.example.com
ACS_OPENCLAW_WORKER_AUTH_TOKEN=<secret>
ACS_HTTP_HSTS=true
ACS_STATE_BACKEND=<production-backend>
ACS_DATABASE_URL=<production-database>
ACS_TELEMETRY_MODE=external
RAILWAY_TOKEN=<railway-token>
