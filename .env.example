# ACS Product API / HTTP control-plane environment
# Copy to .env.local or .env.development. Do not commit secrets.
# Railway private DNS is only reachable from inside Railway's network.

# --- HTTP bind ---
# Railway injects PORT. ACS currently reads ACS_HTTP_PORT; map PORT -> ACS_HTTP_PORT in the service.
ACS_HTTP_HOST=0.0.0.0
ACS_HTTP_PORT=8788
ACS_ENVIRONMENT=development
ACS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Persistence (optional sqlite) ---
ACS_ECONOMIC_STORE=sqlite
ACS_ECONOMIC_DATABASE_PATH=/tmp/acs-economic.sqlite
ACS_AGENT_STORE=sqlite
ACS_AGENT_DATABASE_PATH=/tmp/acs-agent.sqlite
ACS_RUNTIME_DATABASE_PATH=/tmp/acs-runtime.sqlite
ACS_DEPLOYMENT_STORE=sqlite
ACS_DEPLOYMENT_DATABASE_PATH=/tmp/acs-deployment.sqlite
ACS_RATE_LIMIT_PROVIDER=sqlite
ACS_RATE_LIMIT_DATABASE_PATH=/tmp/acs-rate-limit.sqlite
ACS_SECRET_CATALOG_PATH=/tmp/acs-secret-catalog.sqlite

# --- Runtime roots ---
ACS_ROOT=.
ACS_RUNTIME_ROOT=/tmp/acs-runtime
ACS_STATE_ROOT=/tmp/acs-runtime/.acs/state
ACS_CONFIG_ROOT=/tmp/acs-runtime/.acs/config
ACS_ARTIFACTS_ROOT=/tmp/acs-runtime/.acs/artifacts
ACS_WORKSPACE_ROOT=/tmp/acs-runtime/.acs/workspace

# --- Auth (development default; OIDC is optional) ---
ACS_AUTH_MODE=development
# ACS_OIDC_ISSUER=
# ACS_OIDC_AUDIENCE=
# ACS_OIDC_JWKS_URI=
# ACS_OIDC_TENANT_CLAIM=
# ACS_OIDC_PLATFORM_ADMIN_CLAIM=
# ACS_OIDC_PLATFORM_ADMIN_VALUE=

# --- Secrets (memory default) ---
ACS_SECRET_PROVIDER=memory
# ACS_VAULT_ADDR=
# ACS_VAULT_TOKEN=
# ACS_VAULT_NAMESPACE=
# ACS_VAULT_MOUNT=

# --- Optional ---
ACS_DISPATCH_MODE=remote
ACS_DEPLOYMENT_ENGINE=openclaw
ACS_HTTP_HSTS=false
# ACS_TRUSTED_PROXY_CIDRS=
# ACS_OPENCODE_ENDPOINT=http://127.0.0.1:4096

# Optional OpenClaw sidecar. Leave unset on Railway Node-only images.
# ACS_PYTHON_COMMAND=python3
