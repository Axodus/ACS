# Production runtime template.
ACS_ENVIRONMENT=production
ACS_HTTP_HOST=0.0.0.0
ACS_HTTP_PORT=8080
ACS_ALLOWED_ORIGINS=https://acs-app.example.com,https://acs-api.example.com
ACS_AUTH_MODE=production
ACS_SECRET_PROVIDER=production
ACS_DISPATCH_MODE=remote
ACS_OPENCLAW_WORKER_MODE=remote
ACS_OPENCLAW_TRANSPORT=https
ACS_OPENCLAW_WORKER_BASE_URL=https://openclaw-worker.example.com
ACS_OPENCLAW_WORKER_AUTH_TOKEN=<secret>
ACS_HTTP_HSTS=true
ACS_STATE_BACKEND=<production-backend>
ACS_DATABASE_URL=<production-database>
ACS_TELEMETRY_MODE=external
