{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axodus/acs-engine/v1/error-response.schema.json",
  "type": "object",
  "required": ["protocol", "id", "success", "error"],
  "properties": {
    "protocol": { "const": "acs-engine/1" },
    "id": { "type": ["string", "null"] },
    "success": { "const": false },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
